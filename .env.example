# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000
API_PORT=4000

# ---- Postgres (Neon) ----
# Pooled connection for the running app (PgBouncer / Neon pooled endpoint):
DATABASE_URL=postgresql://toastmasters:toastmasters@localhost:5432/toastmasters?schema=public
# Direct (unpooled) connection for migrations:
DIRECT_URL=postgresql://toastmasters:toastmasters@localhost:5432/toastmasters?schema=public

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379

# ---- Session / auth ----
# Argon2id hashes passwords; jose signs httpOnly session tokens with this secret.
# Generate a real one: `openssl rand -base64 48`
SESSION_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_SECONDS=43200

# ---- CORS (comma-separated origin allowlist) ----
CORS_ORIGINS=http://localhost:3000

# ---- Logging ----
LOG_LEVEL=info

# ---- Object storage (MinIO in dev / S3-compatible in prod). Optional until M5. ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=toastmasters
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345

# ---- Email ----
EMAIL_FROM=no-reply@toastmasters.local

# ---- Dashboard -> API ----
# Server-side only. The browser never calls the API directly; it calls the
# dashboard's own /api/* route handlers, which proxy. Deliberately NOT
# NEXT_PUBLIC_*: Next.js inlines those at build time, which would bake a single
# blue/green color into the image. In production compose sets this per color
# (http://api-blue:4000 / http://api-green:4000).
API_INTERNAL_URL=http://localhost:4000

# ---- Deploy-only knobs ----
# Read by the container entrypoint and compose, NOT by packages/config's Zod
# schema — no application code consumes them.
#
# ROLE            which process this container runs: api | worker | dashboard | migrate
# DASHBOARD_PORT  port `next start` binds (default 3000)
# DOMAIN          public hostname Caddy serves and provisions TLS for
# IMAGE_TAG       image tag to run; the deploy sets this to the commit SHA
#
# DOMAIN=toastmasters.example.org
# IMAGE_TAG=latest
