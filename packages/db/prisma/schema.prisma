/**
 * M11 Slice 1: the missing link between "the speech happened" and "the
 * speech counts for Pathways credit". Auto-requested on meeting close for
 * every approved SpeechSlot whose speaker resolves; VPE explicitly
 * approves (or denies) each delivery from the education drawer.
 *
 * `speechSlotId` is unique — one approval per delivered slot, so re-closing
 * a meeting is idempotent. `clubUnitId`, `pathCode`, `projectCode`, `level`
 * are snapshotted from the slot at request time so the approval reflects
 * what was delivered even if the slot's fields drift later.
 *
 * Project completion and level completion are derived from this table, not
 * stored: a project is complete when every catalogue project code has an
 * approved speech; a level is complete when every catalogue project at
 * that level has one.
 */
model SpeechApproval {
  id            String               @id @default(uuid()) @db.Uuid
  speechSlotId  String               @unique @map("speech_slot_id") @db.Uuid
  speechSlot    SpeechSlot           @relation(fields: [speechSlotId], references: [id])
  personId      String               @map("person_id") @db.Uuid
  person        Person               @relation("SpeechApprovalPerson", fields: [personId], references: [id])
  clubUnitId    String               @map("club_unit_id") @db.Uuid
  clubUnit      OrgUnit              @relation(fields: [clubUnitId], references: [id])
  pathCode      String               @map("path_code")
  path          PathwayPath          @relation(fields: [pathCode], references: [pathCode])
  projectCode   String               @map("project_code")
  level         Int
  status        SpeechApprovalStatus @default(requested)
  requestedAt   DateTime             @map("requested_at")
  approvedAt    DateTime?            @map("approved_at")
  approvedBy    String?              @map("approved_by") @db.Uuid
  approver      Person?              @relation("SpeechApprovalApprover", fields: [approvedBy], references: [id])
  deniedAt      DateTime?            @map("denied_at")
  deniedBy      String?              @map("denied_by") @db.Uuid
  denier        Person?              @relation("SpeechApprovalDenier", fields: [deniedBy], references: [id])
  denialReason  String?              @map("denial_reason")
  createdAt     DateTime             @default(now()) @map("created_at")

  @@index([clubUnitId, status])
  @@index([personId, status])
  @@map("speech_approval")
}

enum EvaluationSubjectKind {
  prepared_speech
  table_topic

  @@map("evaluation_subject_kind")
}

enum EvaluationMode {
  form
  audio
  scan

  @@map("evaluation_mode")
}

enum EvaluationVisibility {
  speaker_and_vpe
  speaker_only

  @@map("evaluation_visibility")
}

/**
 * M7 Slice 2: system-design.md §10.2, FR-EDU-4/5. `metricsSnapshot` is
 * copied at submission time, never referenced back to the live timer/
 * ah-counter record — a later correction must not silently rewrite an
 * evaluation. Restricted sensitivity — seeded in M1, first grants land
 * with this slice.
 */
model SpeechEvaluation {
  id                     String                @id @default(uuid()) @db.Uuid
  meetingId              String                @map("meeting_id") @db.Uuid
  meeting                Meeting               @relation(fields: [meetingId], references: [id])
  orgUnitId              String                @map("org_unit_id") @db.Uuid
  orgUnit                OrgUnit               @relation(fields: [orgUnitId], references: [id])
  subjectKind            EvaluationSubjectKind @map("subject_kind")
  speechSlotId           String?               @map("speech_slot_id") @db.Uuid
  speechSlot             SpeechSlot?           @relation(fields: [speechSlotId], references: [id])
  speakerPersonId        String?               @map("speaker_person_id") @db.Uuid
  speakerPerson          Person?               @relation("EvaluationSpeaker", fields: [speakerPersonId], references: [id])
  speakerGuestId      String?               @map("speaker_guest_id") @db.Uuid
  speakerGuest        Guest?             @relation(fields: [speakerGuestId], references: [id])
  evaluatorPersonId      String                @map("evaluator_person_id") @db.Uuid
  evaluatorPerson        Person                @relation("EvaluationEvaluator", fields: [evaluatorPersonId], references: [id])
  mode                   EvaluationMode
  formScales             Json?                 @map("form_scales")
  formExcelledAt         String?               @map("form_excelled_at")
  formWorkOn             String?               @map("form_work_on")
  formChallengeYourself  String?               @map("form_challenge_yourself")
  audioUrl               String?               @map("audio_url")
  scanUrl                String?               @map("scan_url")
  metricsSnapshot        Json                  @map("metrics_snapshot")
  visibility             EvaluationVisibility  @default(speaker_and_vpe)
  submittedAt            DateTime              @default(now()) @map("submitted_at")

  @@map("speech_evaluation")
}

enum MentorshipPurpose {
  new_member_onboarding
  pathway_project
  contest_prep
  officer_transition
  general

