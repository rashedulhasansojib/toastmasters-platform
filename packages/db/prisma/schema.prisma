  mismatch

  @@map("mentorship_ended_reason")
}

/** M7 Slice 3: system-design.md §10.3, FR-EDU-6. Ending a pairing never deletes goals/checkIns history. At most one `active` pairing per (mentee, purpose) — enforced in the service (see the M7 plan doc's note on the race window). */
model MentorshipPairing {
  id             String                  @id @default(uuid()) @db.Uuid
  orgUnitId      String                  @map("org_unit_id") @db.Uuid
  orgUnit        OrgUnit                 @relation(fields: [orgUnitId], references: [id])
  programYearId  String                  @map("program_year_id")
  programYear    ProgramYear             @relation(fields: [programYearId], references: [id])
  mentorPersonId String                  @map("mentor_person_id") @db.Uuid
  mentorPerson   Person                  @relation("MentorshipMentor", fields: [mentorPersonId], references: [id])
  menteePersonId String                  @map("mentee_person_id") @db.Uuid
  menteePerson   Person                  @relation("MentorshipMentee", fields: [menteePersonId], references: [id])
  purpose        MentorshipPurpose
  status         MentorshipStatus        @default(proposed)
  startedAt      DateTime                @default(now()) @map("started_at")
  endedAt        DateTime?               @map("ended_at")
  endedReason    MentorshipEndedReason?  @map("ended_reason")
  assignedBy     String                  @map("assigned_by") @db.Uuid
  assignedByPerson Person                @relation("MentorshipAssignedBy", fields: [assignedBy], references: [id])
  goals          Json                    @default("[]")
  checkIns       Json                    @default("[]") @map("check_ins")

  @@map("mentorship_pairing")
}

/** M7 Slice 3. */
model MentorAvailability {
