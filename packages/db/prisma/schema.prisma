/** M7 Slice 4: system-design.md §10.4, FR-EDU-7. `orgUnitId: null` means district-wide default. */
model OnboardingTrack {
  id        String              @id @default(uuid()) @db.Uuid
  orgUnitId String?             @map("org_unit_id") @db.Uuid
  orgUnit   OrgUnit?            @relation(fields: [orgUnitId], references: [id])
  name      String
  audience  OnboardingAudience
  forRoles  String[]            @default([]) @map("for_roles")
  isActive  Boolean             @default(true) @map("is_active")
  steps     Json
  createdAt DateTime            @default(now()) @map("created_at")
  progress  OnboardingProgress[]

  @@map("onboarding_track")
}

/** `steps` is a snapshot of the track's steps at enrolment time — a later track edit never rewrites a member's in-progress checklist, same pattern as `ChecklistRun`. */
model OnboardingProgress {
  id          String          @id @default(uuid()) @db.Uuid
  personId    String          @map("person_id") @db.Uuid
  person      Person          @relation(fields: [personId], references: [id])
  trackId     String          @map("track_id") @db.Uuid
  track       OnboardingTrack @relation(fields: [trackId], references: [id])
  orgUnitId   String          @map("org_unit_id") @db.Uuid
  orgUnit     OrgUnit         @relation(fields: [orgUnitId], references: [id])
  enrolledAt  DateTime        @default(now()) @map("enrolled_at")
  steps       Json
  completedAt DateTime?       @map("completed_at")
  nudgedAt    DateTime?       @map("nudged_at")

  @@map("onboarding_progress")
}

