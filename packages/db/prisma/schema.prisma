// Phase 0 proved the database SEAM with zero models. M1 (walking skeleton)
// begins cutting the domain schema here, starting with OrgUnit (Slice 1) — the
// scope backbone every grant and access check is placed on. Additional domain
// tables remain gated on the nine open decisions in CLAUDE.md until each is
// settled.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Prisma 7 no longer accepts connection URLs in the schema. The app runtime
// connects through the pg driver adapter with the pooled DATABASE_URL (see
// src/client.ts); migrations use the direct/unpooled DIRECT_URL, configured in
// prisma.config.ts. This block only declares the provider.
datasource db {
  provider = "postgresql"
}

enum OrgUnitType {
  international
  region
  district
  division
  area
  club
}

enum OrgUnitStatus {
  active
  low
  ineligible
  suspended
  dissolved
}

model OrgUnit {
  id        String        @id @default(uuid()) @db.Uuid
  type      OrgUnitType
  parentId  String?       @map("parent_id") @db.Uuid
  parent    OrgUnit?      @relation("OrgUnitChildren", fields: [parentId], references: [id])
  children  OrgUnit[]     @relation("OrgUnitChildren")
  // ltree; Prisma has no native ltree type, so it is Unsupported and handled via raw SQL.
  path      Unsupported("ltree")
  depth     Int
  name      String
  code      String
  status    OrgUnitStatus @default(active)
  timezone  String
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  /// M4 Slice 6 / CLAUDE.md §2 decision 7: flat semiannual local dues — one amount per club, not per-membership-configurable. Meaningful only for `type: club` rows.
  localDuesAmount Decimal? @map("local_dues_amount") @db.Decimal(10, 2)
  tiDuesAmount    Decimal? @map("ti_dues_amount") @db.Decimal(10, 2)
  duesCurrency    String?  @map("dues_currency")

  clubMemberships ClubMembership[]
  roleAssignments RoleAssignment[]
  platformRoleAssignments PlatformRoleAssignment[]
  unitPolicyGrants UnitPolicyGrant[]
  personGrants     PersonGrant[]
  auditEvents      AuditEvent[]
  meetings         Meeting[]
  invitations      Invitation[]
  meetingRoleAssignments MeetingRoleAssignment[]
  checklistTemplates     ChecklistTemplate[]
  checklistRuns          ChecklistRun[]
  agendaTemplates        AgendaTemplate[]
  meetingTemplates       MeetingTemplate[]
  guests              Guest[]
  ledgerEntries          LedgerEntry[]
  duesRecords            DuesRecord[]
  invoices               Invoice[]
  invoiceSequences       InvoiceSequence[]
  installmentPlans       InstallmentPlan[]
  financialReports       FinancialReport[]
  libraryItems           LibraryItem[]
  contentPlanItems       ContentPlanItem[]
  inventoryItems         InventoryItem[]
  inventoryMovements     InventoryMovement[]
  areaVisitReportsAsArea AreaVisitReport[] @relation("AreaVisitReportArea")
  areaVisitReportsAsClub AreaVisitReport[] @relation("AreaVisitReportClub")
  presidentContactLogsAsArea PresidentContactLog[] @relation("PresidentContactLogArea")
  presidentContactLogsAsClub PresidentContactLog[] @relation("PresidentContactLogClub")
  clubSuccessPlans       ClubSuccessPlan[]
  dcpProjections         DcpProjection[]
  clubHealthSnapshots    ClubHealthSnapshot[]
  tickets                Ticket[]
  educationRecords       EducationRecord[]
  speechApprovals        SpeechApproval[]
  speechEvaluations      SpeechEvaluation[]
  mentorshipPairings     MentorshipPairing[]
  mentorAvailabilities   MentorAvailability[]
  onboardingTracks       OnboardingTrack[]
  onboardingProgress     OnboardingProgress[]
  excomMeetings          ExComMeeting[]
  minutes                Minutes[]
  supportRequests        SupportRequest[]
  memberHealthSignals    MemberHealthSignal[]

  @@index([parentId])
  @@map("org_unit")
}

enum PersonStatus {
  invited
  active
  disabled
}

model Person {
  id                String       @id @default(uuid()) @db.Uuid
  email             String       @unique
  passwordHash      String?      @map("password_hash")
  fullName          String       @map("full_name")
  phone             String?
  photoUrl          String?      @map("photo_url")
  bio               String?
  tiMemberNumber    String?      @map("ti_member_number")
  status            PersonStatus @default(invited)
  mfaEnabled        Boolean      @default(false) @map("mfa_enabled")
  permissionVersion Int          @default(1) @map("permission_version")
  createdAt         DateTime     @default(now()) @map("created_at")
  lastLoginAt       DateTime?    @map("last_login_at")
  /// Users admin soft-delete (super-admin People page). Set only by
  /// PersonRepository.softDelete — the same transaction that ends active
  /// role assignments, deactivates club memberships, clears the password
  /// hash and bumps permission_version. Excluded from search() by default and
  /// from the default admin list, but explicitly reachable via search's
  /// includeDeleted flag or a direct id (the detail route no longer filters
  /// on it) — an admin has to be able to find a deleted person to restore
  /// them. Cleared only by PersonRepository.restore, which resets status to
  /// 'invited'; the role assignments and memberships ended at delete time are
  /// not reinstated.
  deletedAt         DateTime?    @map("deleted_at")

  clubMemberships ClubMembership[]
  roleAssignments RoleAssignment[] @relation("RoleAssignmentPerson")
  appointedRoles  RoleAssignment[] @relation("RoleAssignmentAppointedBy")
  platformRoleAssignments PlatformRoleAssignment[] @relation("PlatformRoleAssignmentPerson")
  grantedPlatformRoles    PlatformRoleAssignment[] @relation("PlatformRoleAssignmentGrantedBy")
  unitPolicyGrantsAsSubject UnitPolicyGrant[] @relation("UnitPolicyGrantSubject")
  unitPolicyGrantsCreated   UnitPolicyGrant[] @relation("UnitPolicyGrantCreatedBy")
  personGrantsReceived      PersonGrant[]     @relation("PersonGrantSubject")
  personGrantsIssued        PersonGrant[]     @relation("PersonGrantGrantedBy")
  auditEvents               AuditEvent[]
  meetingsCreated           Meeting[]
  meetingGuestsAdded        MeetingGuest[]
  invitationsSent           Invitation[] @relation("InvitationInvitedBy")
  invitationsAccepted       Invitation[] @relation("InvitationAcceptedBy")
  meetingRoleAssignments    MeetingRoleAssignment[]
  speechSlotsRequested      SpeechSlot[]
  capabilityTokensIssued    CapabilityToken[]
  meetingLiveRecords        MeetingLiveRecord[]
  ballotsCreated            Ballot[]
  votesReceived             Vote[]              @relation("VoteCandidate")
  guestsCreated          Guest[]          @relation("GuestCreatedBy")
  convertedFromGuests    Guest[]          @relation("GuestConvertedToPerson")
  guestVisitsLogged      GuestVisit[]
  guestCommunicationsLogged GuestCommunication[]
  ledgerEntriesRecorded     LedgerEntry[]
  duesRecords               DuesRecord[]
  installmentPlans          InstallmentPlan[] @relation("InstallmentPlanPerson")
  installmentPlansApproved  InstallmentPlan[] @relation("InstallmentPlanApprovedBy")
  financialReportsGenerated FinancialReport[] @relation("FinancialReportGeneratedBy")
  financialReportsApproved  FinancialReport[] @relation("FinancialReportApprovedBy")
  libraryItemsUploaded      LibraryItem[]
  contentPlanItemsAssigned  ContentPlanItem[]
  inventoryItemsCustodied   InventoryItem[]
  inventoryMovementsMade    InventoryMovement[]
  areaVisitReportsFiled     AreaVisitReport[]
  presidentContactLogsMade  PresidentContactLog[]
  clubSuccessPlansSubmitted ClubSuccessPlan[]
  ticketsCreated            Ticket[]           @relation("TicketCreatedBy")
  ticketsResolved           Ticket[]           @relation("TicketResolvedBy")
  ticketCommentsMade        TicketComment[]
  educationRecords          EducationRecord[]
  evaluationsAsSpeaker      SpeechEvaluation[] @relation("EvaluationSpeaker")
  evaluationsAsEvaluator    SpeechEvaluation[] @relation("EvaluationEvaluator")
  mentorshipsAsMentor       MentorshipPairing[] @relation("MentorshipMentor")
  mentorshipsAsMentee       MentorshipPairing[] @relation("MentorshipMentee")
  mentorshipsAssigned       MentorshipPairing[] @relation("MentorshipAssignedBy")
  mentorAvailability        MentorAvailability[]
  onboardingProgress        OnboardingProgress[]
  excomMeetingsCalled       ExComMeeting[]
  motionsMoved              Motion[]             @relation("MotionMovedBy")
  motionsSeconded           Motion[]             @relation("MotionSecondedBy")
  minutesDrafted            Minutes[]            @relation("MinutesDraftedBy")
  minutesApproved           Minutes[]            @relation("MinutesApprovedBy")
  supportProfile            SupportProfile?
  meetingAttendance         MeetingAttendanceRecord[] @relation("MeetingAttendancePerson")
  meetingAttendanceRecorded MeetingAttendanceRecord[] @relation("MeetingAttendanceRecordedBy")
  meetingResourcesCreated   MeetingResource[]
  meetingTemplatesCreated   MeetingTemplate[]
  speechSlotsAsSpeaker      SpeechSlot[]        @relation("SpeechSlotSpeaker")
  speechSlotsAsEvaluator    SpeechSlot[]        @relation("SpeechSlotEvaluator")
  speechApprovalsForMe      SpeechApproval[]    @relation("SpeechApprovalPerson")
  speechApprovalsApproved   SpeechApproval[]    @relation("SpeechApprovalApprover")
  speechApprovalsDenied     SpeechApproval[]    @relation("SpeechApprovalDenier")
  memberHealthSignals       MemberHealthSignal[]

  // Users admin (super-admin People search): search-by-name / search-by-TI-number.
  // email is already indexed via its own @unique.
  @@index([fullName])
  @@index([tiMemberNumber])
  @@map("person")
}

enum ClubMemberType {
  new
  renewing
  dual
  reinstated
  charter
  transfer
  honorary
}

enum ClubMembershipTiStanding {
  good
  lapsed
  unknown
}

enum ClubMembershipLocalStatus {
  active
  inactive
  on_leave
  suspended
}

enum ClubMembershipProvenance {
  portal
  ti_import
}

model ClubMembership {
  id               String                    @id @default(uuid()) @db.Uuid
  personId         String                    @map("person_id") @db.Uuid
  person           Person                    @relation(fields: [personId], references: [id])
  clubUnitId       String                    @map("club_unit_id") @db.Uuid
  clubUnit         OrgUnit                   @relation(fields: [clubUnitId], references: [id])
  memberType       ClubMemberType            @map("member_type")
  joinedAt         DateTime                  @default(now()) @map("joined_at")
  leftAt           DateTime?                 @map("left_at")
  isPrimary        Boolean                   @default(false) @map("is_primary")
  tiStanding       ClubMembershipTiStanding  @default(unknown) @map("ti_standing")
  localStatus      ClubMembershipLocalStatus @default(active) @map("local_status")
  provenance       ClubMembershipProvenance  @default(portal)
  lastReconciledAt DateTime?                 @map("last_reconciled_at")
  duesRecords      DuesRecord[]
  healthSignal     MemberHealthSignal?

  @@index([clubUnitId, localStatus])
  @@map("club_membership")
}

enum RoleAssignmentStatus {
  pending
  active
  ended
  revoked
}

enum RoleAssignmentEndedReason {
  term_end
  resigned
  removed
  succeeded
}

model RoleAssignment {
  id                String                     @id @default(uuid()) @db.Uuid
  personId          String                     @map("person_id") @db.Uuid
  person            Person                     @relation("RoleAssignmentPerson", fields: [personId], references: [id])
  orgUnitId         String                     @map("org_unit_id") @db.Uuid
  orgUnit           OrgUnit                    @relation(fields: [orgUnitId], references: [id])
  // Plain text until Slice 3 seeds role_template and adds the FK — rbac-design.md §3.
  role              String
  programYearId     String                     @map("program_year_id")
  programYear       ProgramYear                @relation(fields: [programYearId], references: [id])
  termStart         DateTime                   @map("term_start") @db.Date
  termEnd           DateTime                   @map("term_end") @db.Date
  status            RoleAssignmentStatus       @default(pending)
  appointedBy       String                     @map("appointed_by") @db.Uuid
  appointedByPerson Person                     @relation("RoleAssignmentAppointedBy", fields: [appointedBy], references: [id])
  appointedAt       DateTime                   @default(now()) @map("appointed_at")
  trainedAt         Json                       @default("[]") @map("trained_at")
  endedReason       RoleAssignmentEndedReason? @map("ended_reason")

  @@map("role_assignment")
}

enum ProgramYearStatus {
  upcoming
  current
  closed
}

model ProgramYear {
  id       String            @id // e.g. "2026-2027" — not a UUID
  startsOn DateTime          @map("starts_on") @db.Date
  endsOn   DateTime          @map("ends_on") @db.Date
  status   ProgramYearStatus @default(upcoming)

  roleAssignments RoleAssignment[]
  meetings        Meeting[]
  invitations     Invitation[]
  ledgerEntries   LedgerEntry[]
  duesRecords     DuesRecord[]
  invoices        Invoice[]
  invoiceSequences InvoiceSequence[]
  financialReports FinancialReport[]
  libraryItems     LibraryItem[]
  contentPlanItems ContentPlanItem[]
  areaVisitReports AreaVisitReport[]
  presidentContactLogs PresidentContactLog[]
  clubSuccessPlans ClubSuccessPlan[]
  dcpProjections   DcpProjection[]
  mentorshipPairings MentorshipPairing[]
  excomMeetings      ExComMeeting[]
  minutes            Minutes[]
  memberHealthSignals MemberHealthSignal[]

  @@map("program_year")
}

/**
 * Deliberately bare (Slice 9 — the M1 ship gate needs a record to hang
 * authorization on, not meeting operations). system-design.md's full entity
 * (agenda, roles, speech slots, lifecycle states, checklists) is a later
 * milestone.
 */
enum MeetingStatus {
  draft
  published
  in_progress
  closed
  cancelled

  @@map("meeting_status")
}

model Meeting {
  id              String      @id @default(uuid()) @db.Uuid
  clubUnitId      String      @map("club_unit_id") @db.Uuid
  clubUnit        OrgUnit     @relation(fields: [clubUnitId], references: [id])
  programYearId   String      @map("program_year_id")
  programYear     ProgramYear @relation(fields: [programYearId], references: [id])
  scheduledAt     DateTime    @map("scheduled_at")
  status          MeetingStatus @default(draft)
  // M9 slice — descriptive metadata carried over from the legacy portal.
  // All optional so drafts remain cheap to create; edited from the detail
  // page or the create form. `wordOfDay` and `tableTopicQuestions` are JSONB
  // to keep the shape flexible without a proliferation of side tables.
  title              String?  @db.VarChar(200)
  theme              String?  @db.VarChar(200)
  venue              String?  @db.VarChar(200)
  meetingNumber      Int?     @map("meeting_number")
  wordOfDay          Json?    @map("word_of_day")
  tableTopicQuestions Json?   @map("table_topic_questions")
  joinUrl            String?  @map("join_url") @db.VarChar(500)
  createdBy       String      @map("created_by") @db.Uuid
  createdByPerson Person      @relation(fields: [createdBy], references: [id])
  createdAt       DateTime    @default(now()) @map("created_at")
  agendaItems     AgendaItem[]
  roleAssignments MeetingRoleAssignment[]
  speechSlots     SpeechSlot[]
  checklistRuns   ChecklistRun[]
  capabilityTokens CapabilityToken[]
  liveRecords     MeetingLiveRecord[]
  ballots         Ballot[]
  guestVisits  GuestVisit[]
  contentPlanItems ContentPlanItem[]
  inventoryMovements InventoryMovement[]
  speechEvaluations SpeechEvaluation[]
  minutes          Minutes[]
  supportRequests  SupportRequest[]
  guests           MeetingGuest[]
  attendanceRecords MeetingAttendanceRecord[]
  resources        MeetingResource[]

  @@map("meeting")
}

enum BallotCategory {
  best_speaker
  best_table_topic
  best_evaluator
  best_role_player

  @@map("ballot_category")
}

enum BallotStatus {
  open
  tallied

  @@map("ballot_status")
}

enum BallotEligibility {
  members_present
  all_present

  @@map("ballot_eligibility")
}

/**
 * M3 Slice 10: system-design.md §9.4. Scoped down: a ballot is created
 * already `open` — the spec's separate closed→open transition is collapsed
 * into one step (nothing needs a ballot to exist-but-not-yet-be-votable
 * yet). `eligibility: all_present` is stored but not yet behaviorally wired
 * to guest voting — casting a vote via a capability token (the natural
 * `all_present` consumer, per the Slice 6 primitive) is deferred; only
 * authenticated club members vote in this slice.
 * `candidates` is a Json snapshot — member-only PersonRef for now, no
 * GuestRef candidates until M4.
 */
model Ballot {
  id          String            @id @default(uuid()) @db.Uuid
  meetingId   String            @map("meeting_id") @db.Uuid
  meeting     Meeting           @relation(fields: [meetingId], references: [id])
  category    BallotCategory
  status      BallotStatus      @default(open)
  eligibility BallotEligibility
  candidates  Json
  createdBy   String            @map("created_by") @db.Uuid
  createdByPerson Person        @relation(fields: [createdBy], references: [id])
  createdAt   DateTime          @default(now()) @map("created_at")
  tallyResult Json?             @map("tally_result")
  talliedBy   String?           @map("tallied_by") @db.Uuid
  talliedAt   DateTime?         @map("tallied_at")
  votes       Vote[]

  @@unique([meetingId, category])
  @@map("ballot")
}

/**
 * `voterHash = HMAC-SHA256(key: ballotId, message: personId)` (system-design.md
 * §9.4) — enforces one vote per person per ballot and detects duplicates
 * without the row itself revealing who voted for whom.
 */
model Vote {
  id                String   @id @default(uuid()) @db.Uuid
  ballotId          String   @map("ballot_id") @db.Uuid
  ballot            Ballot   @relation(fields: [ballotId], references: [id])
  voterHash         String   @map("voter_hash")
  candidatePersonId String   @map("candidate_person_id") @db.Uuid
  candidate         Person   @relation("VoteCandidate", fields: [candidatePersonId], references: [id])
  castAt            DateTime @default(now()) @map("cast_at")

  @@unique([ballotId, voterHash])
  @@map("vote")
}

enum MeetingLiveToolKind {
  timer
  ah_counter
  grammarian

  @@map("meeting_live_tool_kind")
}

/**
 * M3 Slice 7: system-design.md §9.1's timerRecord[]/ahCounterRecord[]/
 * grammarianRecord, consolidated into one table with a `kind` discriminator
 * and a `payload` Json column (see the Slice 7 plan note) instead of three
 * separate tables — the three shapes never share a query, only a write
 * path, so one idempotent-write table is enough.
 * FR-MTG-6/NFR-3: `clientKey` is client-minted so a venue-wifi drop can
 * safely retry the same write without creating a duplicate.
 */
model MeetingLiveRecord {
  id                     String              @id @default(uuid()) @db.Uuid
  meetingId              String              @map("meeting_id") @db.Uuid
  meeting                Meeting             @relation(fields: [meetingId], references: [id])
  kind                   MeetingLiveToolKind
  clientKey              String              @map("client_key")
  targetRoleAssignmentId String?             @map("target_role_assignment_id") @db.Uuid
  targetRoleAssignment   MeetingRoleAssignment? @relation(fields: [targetRoleAssignmentId], references: [id])
  targetLabel            String?             @map("target_label")
  payload                Json
  recordedBy             String              @map("recorded_by") @db.Uuid
  recordedByPerson       Person              @relation(fields: [recordedBy], references: [id])
  createdAt              DateTime            @default(now()) @map("created_at")

  @@unique([meetingId, clientKey])
  @@map("meeting_live_record")
}

/**
 * M3 Slice 6: roadmap.md's single guest primitive — "guests never
 * authenticate; every guest interaction runs through the capability-token
 * primitive, hashed, expiring, revocable, revoked at meeting close." Only
 * `tokenHash` is ever persisted; the raw token is returned once, on issue.
 * `purpose` is a free string, not an enum — concrete guest interactions
 * (ballot casting, etc.) are added by later slices without a migration.
 */
model CapabilityToken {
  id                String    @id @default(uuid()) @db.Uuid
  meetingId         String    @map("meeting_id") @db.Uuid
  meeting           Meeting   @relation(fields: [meetingId], references: [id])
  purpose           String
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  createdBy         String    @map("created_by") @db.Uuid
  createdByPerson   Person    @relation(fields: [createdBy], references: [id])
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("capability_token")
}

/**
 * M3 Slice 9: reusable agenda template, mirroring `ChecklistTemplate`'s
 * shape — a club builds one once, applies it to many meetings. `items` is a
 * Json snapshot copied onto real `AgendaItem` rows on apply, never
 * referenced live.
 */
model AgendaTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  orgUnitId String   @map("org_unit_id") @db.Uuid
  orgUnit   OrgUnit  @relation(fields: [orgUnitId], references: [id])
  name      String
  items     Json
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("agenda_template")
}

/** M3 Slice 1: system-design.md §9.1's agendaItem[] — server-assigned, append-only position. */
model AgendaItem {
  id                     String   @id @default(uuid()) @db.Uuid
  meetingId              String   @map("meeting_id") @db.Uuid
  meeting                Meeting  @relation(fields: [meetingId], references: [id])
  position               Int
  title                  String
  plannedDurationSeconds Int      @map("planned_duration_seconds")
  roleKey                String?  @map("role_key")
  createdAt              DateTime @default(now()) @map("created_at")

  @@unique([meetingId, position])
  @@map("agenda_item")
}

/** system-design.md §9.2's fixed roleKey vocabulary — extend via migration, not app code. */
enum MeetingRoleKey {
  toastmaster
  general_evaluator
  table_topics_master
  table_topics_evaluator
  timer
  ah_counter
  grammarian
  sergeant_at_arms
  president
  speaker
  evaluator

  @@map("meeting_role_key")
}

/**
 * `guest` was deferred in M3 Slice 3 because Guest didn't exist yet; enabled
 * in M4 alongside the planner UX parity work — see system-design.md §9.2.
 * A guest cell references a real Guest row (identity, not a name string) and
 * a Guest can hold planning roles like TMOD or Timer for a meeting they're
 * invited to. Guests still never authenticate (FR-MEM-4) — this is a
 * plan-side reference, not a login.
 */
enum MeetingRoleAssigneeKind {
  member
  cross_club
  guest
  unfilled

  @@map("meeting_role_assignee_kind")
}

enum MeetingRoleAssignmentStatus {
  proposed
  confirmed
  declined
  fulfilled
  no_show

  @@map("meeting_role_assignment_status")
}

/**
 * M3 Slice 3: system-design.md §9.2 — role assignments reference identity,
 * not strings. Status transitions (confirm/decline/fulfil) are a later
 * slice; this slice only proves the shape (assignments are created
 * `proposed` and read back).
 */
model MeetingRoleAssignment {
  id                     String                      @id @default(uuid()) @db.Uuid
  meetingId              String                      @map("meeting_id") @db.Uuid
  meeting                Meeting                     @relation(fields: [meetingId], references: [id])
  roleKey                MeetingRoleKey              @map("role_key")
  slotIndex              Int?                        @map("slot_index")
  assigneeKind           MeetingRoleAssigneeKind     @map("assignee_kind")
  assigneePersonId       String?                     @map("assignee_person_id") @db.Uuid
  assigneePerson         Person?                     @relation(fields: [assigneePersonId], references: [id])
  assigneeHomeClubUnitId String?                     @map("assignee_home_club_unit_id") @db.Uuid
  assigneeHomeClubUnit   OrgUnit?                    @relation(fields: [assigneeHomeClubUnitId], references: [id])
  assigneeGuestId        String?                     @map("assignee_guest_id") @db.Uuid
  assigneeGuest          Guest?                      @relation(fields: [assigneeGuestId], references: [id])
  status                 MeetingRoleAssignmentStatus @default(proposed)
  confirmedAt            DateTime?                   @map("confirmed_at")
  fulfilledAt            DateTime?                   @map("fulfilled_at")
  declinedReason         String?                     @map("declined_reason")
  createdAt              DateTime                    @default(now()) @map("created_at")
  liveRecords            MeetingLiveRecord[]

  @@map("meeting_role_assignment")
}

/**
 * M3 Slice 4: system-design.md §10.1's PathCatalog, trimmed to what
 * speech-slot request validation needs — `requiredRoleKeys` /
 * `requiresEducationSeries` / `isVintage` are EducationRecord (M7)
 * concerns, deferred until that model exists. Seeded reference data,
 * editable without a deploy — same rule as the RBAC resource catalogue.
 */
model PathwayPath {
  pathCode   String            @id @map("path_code")
  name       String
  credential String
  isActive   Boolean           @default(true) @map("is_active")
  createdAt  DateTime          @default(now()) @map("created_at")
  projects   PathwayProject[]
  speechSlots SpeechSlot[]
  educationRecords EducationRecord[]
  speechApprovals  SpeechApproval[]

  @@map("pathway_path")
}

model PathwayProject {
  id          String      @id @default(uuid()) @db.Uuid
  pathCode    String      @map("path_code")
  path        PathwayPath @relation(fields: [pathCode], references: [pathCode])
  projectCode String      @map("project_code")
  name        String
  level       Int
  minMinutes  Int         @map("min_minutes")
  maxMinutes  Int         @map("max_minutes")

  @@unique([pathCode, projectCode])
  @@map("pathway_project")
}

enum SpeechSlotStatus {
  requested
  approved
  declined

  @@map("speech_slot_status")
}

/**
 * M3 Slice 4: system-design.md §9.1's speechSlot[] — request/approval with
 * path validation.
 *
 * M9: this is also the agenda's "Prepared Speakers" block (the legacy
 * portal's `speakers[]`), so it carries the pairing the printed agenda
 * needs: who actually delivers the speech, who evaluates it, and where it
 * sits in the running order.
 *
 * `requestedBy` (who filed the request) stays distinct from
 * `speakerPersonId` (who speaks) — a VPE building next week's agenda files
 * slots on other members' behalf. `speakerPersonId` null means "the
 * requester speaks", which is the self-service case.
 */
model SpeechSlot {
  id                     String           @id @default(uuid()) @db.Uuid
  meetingId              String           @map("meeting_id") @db.Uuid
  meeting                Meeting          @relation(fields: [meetingId], references: [id])
  position               Int              @default(0)
  title                  String
  pathCode               String           @map("path_code")
  path                   PathwayPath      @relation(fields: [pathCode], references: [pathCode])
  projectCode            String           @map("project_code")
  level                  Int
  plannedDurationSeconds Int              @map("planned_duration_seconds")
  requestedBy            String           @map("requested_by") @db.Uuid
  requestedByPerson      Person           @relation(fields: [requestedBy], references: [id])
  speakerPersonId        String?          @map("speaker_person_id") @db.Uuid
  speakerPerson          Person?          @relation("SpeechSlotSpeaker", fields: [speakerPersonId], references: [id])
  evaluatorPersonId      String?          @map("evaluator_person_id") @db.Uuid
  evaluatorPerson        Person?          @relation("SpeechSlotEvaluator", fields: [evaluatorPersonId], references: [id])
  notes                  String?
  status                 SpeechSlotStatus @default(requested)
  createdAt              DateTime         @default(now()) @map("created_at")
  evaluations            SpeechEvaluation[]
  approval               SpeechApproval?

  @@map("speech_slot")
}

enum ChecklistAppliesTo {
  meeting
  excom
  contest
  special_event

  @@map("checklist_applies_to")
}

/**
 * M3 Slice 5: system-design.md §14.1. `items` is a Json snapshot
 * (`{ key, order, label, ownerRole, phase }[]`) — reusable across runs, so
 * not modeled as its own table. Auto-creation on meeting `publish` is
 * deferred: `Meeting` has no lifecycle status yet (M1 left it deliberately
 * bare) — a run is created explicitly by the caller for now.
 */
model ChecklistTemplate {
  id        String             @id @default(uuid()) @db.Uuid
  orgUnitId String             @map("org_unit_id") @db.Uuid
  orgUnit   OrgUnit            @relation(fields: [orgUnitId], references: [id])
  name      String
  appliesTo ChecklistAppliesTo @map("applies_to")
  items     Json
  isActive  Boolean            @default(true) @map("is_active")
  createdAt DateTime           @default(now()) @map("created_at")
  runs      ChecklistRun[]

  @@map("checklist_template")
}

/** `items` is a snapshot at run-creation time (`{ key, label, phase, done, doneBy, doneAt, note }[]`), so later template edits never rewrite history. */
model ChecklistRun {
  id          String            @id @default(uuid()) @db.Uuid
  orgUnitId   String            @map("org_unit_id") @db.Uuid
  orgUnit     OrgUnit           @relation(fields: [orgUnitId], references: [id])
  templateId  String            @map("template_id") @db.Uuid
  template    ChecklistTemplate @relation(fields: [templateId], references: [id])
  meetingId   String?           @map("meeting_id") @db.Uuid
  meeting     Meeting?          @relation(fields: [meetingId], references: [id])
  items       Json
  startedAt   DateTime          @default(now()) @map("started_at")
  completedAt DateTime?         @map("completed_at")

  @@map("checklist_run")
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

/**
 * M2 Slice 1: system-design.md §6.4. Carries a single-role intent (not the
 * full roles: Array<...> the design doc sketches) — enough to prove the
 * mechanism and the delegation check; see the Slice 1 plan's scoping note.
 */
model Invitation {
  id               String           @id @default(uuid()) @db.Uuid
  email            String
  tokenHash        String           @unique @map("token_hash")
  orgUnitId        String           @map("org_unit_id") @db.Uuid
  orgUnit          OrgUnit          @relation(fields: [orgUnitId], references: [id])
  role             String
  /// Users admin follow-up to M2 Slice 1's scoping note: set only when
  /// `orgUnit.type === 'club'` — accept() upserts an active ClubMembership
  /// alongside the RoleAssignment when present. Null preserves the original
  /// invitation shape for non-club-tier invites (district/division/area).
  memberType       ClubMemberType?  @map("member_type")
  programYearId    String           @map("program_year_id")
  programYear      ProgramYear      @relation(fields: [programYearId], references: [id])
  invitedBy        String           @map("invited_by") @db.Uuid
  invitedByPerson  Person           @relation("InvitationInvitedBy", fields: [invitedBy], references: [id])
  status           InvitationStatus @default(pending)
  expiresAt        DateTime         @map("expires_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  acceptedAt       DateTime?        @map("accepted_at")
  acceptedPersonId String?          @map("accepted_person_id") @db.Uuid
  acceptedPerson   Person?          @relation("InvitationAcceptedBy", fields: [acceptedPersonId], references: [id])

  @@index([email, status])
  @@map("invitation")
}

enum ResourceSensitivity {
  normal
  sensitive
  restricted
}

enum PermissionAction {
  read
  create
  update
  delete
  approve
  export
}

enum PermissionCondition {
  any
  own
  assigned
  party
  published
}

enum PermissionEffect {
  allow
  deny
}

model ResourceCatalog {
  resource       String              @id
  context        String
  label          String
  description    String?
  allowedActions PermissionAction[]  @map("allowed_actions")
  clubScoped     Boolean             @default(true) @map("club_scoped")
  sensitivity    ResourceSensitivity @default(normal)

  grants RoleTemplateGrant[]
  unitPolicyGrants UnitPolicyGrant[]
  personGrants     PersonGrant[]

  @@map("resource_catalog")
}

enum RoleTemplateTier {
  club
  area
  division
  district
  platform
}

enum RoleTemplateScopeRule {
  self_unit
  self_subtree
}

model RoleTemplate {
  role        String                @id
  tier        RoleTemplateTier
  unitTypes   OrgUnitType[]         @map("unit_types")
  scopeRule   RoleTemplateScopeRule @default(self_unit) @map("scope_rule")
  isSingleton Boolean               @default(true) @map("is_singleton")
  isSystem    Boolean               @default(false) @map("is_system")
  label       String

  grants RoleTemplateGrant[]

  @@map("role_template")
}

model RoleTemplateGrant {
  role         String
  roleTemplate RoleTemplate        @relation(fields: [role], references: [role], onDelete: Cascade)
  resource     String
  resourceRef  ResourceCatalog     @relation(fields: [resource], references: [resource])
  action       PermissionAction
  condition    PermissionCondition @default(any)
  effect       PermissionEffect    @default(allow)
  fields       String[]            @default([])

  @@id([role, resource, action, condition])
  @@map("role_template_grant")
}

model PlatformRoleAssignment {
  // A synthetic id, not the composite (person_id, role, org_unit_id) primary
  // key rbac-design.md §3 table 6 shows — Postgres cannot put a nullable
  // column (org_unit_id is NULL for global roles) inside a PRIMARY KEY. The
  // @@unique below carries the intended uniqueness instead; Postgres treats
  // multiple NULL org_unit_id rows as non-conflicting, which is acceptable
  // here since this slice inserts no rows into this table at all.
  id              String    @id @default(uuid()) @db.Uuid
  personId        String    @map("person_id") @db.Uuid
  person          Person    @relation("PlatformRoleAssignmentPerson", fields: [personId], references: [id])
  role            String
  orgUnitId       String?   @map("org_unit_id") @db.Uuid
  orgUnit         OrgUnit?  @relation(fields: [orgUnitId], references: [id])
  grantedBy       String    @map("granted_by") @db.Uuid
  grantedByPerson Person    @relation("PlatformRoleAssignmentGrantedBy", fields: [grantedBy], references: [id])
  grantedAt       DateTime  @default(now()) @map("granted_at")
  expiresAt       DateTime? @map("expires_at")

  @@unique([personId, role, orgUnitId])
  @@map("platform_role_assignment")
}

enum UnitPolicySubjectKind {
  role
  person
}

model UnitPolicyGrant {
  id              String                @id @default(uuid()) @db.Uuid
  orgUnitId       String                @map("org_unit_id") @db.Uuid
  orgUnit         OrgUnit               @relation(fields: [orgUnitId], references: [id])
  subjectKind     UnitPolicySubjectKind @map("subject_kind")
  subjectRole     String?               @map("subject_role")
  subjectPersonId String?               @map("subject_person_id") @db.Uuid
  subjectPerson   Person?               @relation("UnitPolicyGrantSubject", fields: [subjectPersonId], references: [id])
  resource        String
  resourceRef     ResourceCatalog       @relation(fields: [resource], references: [resource])
  action          PermissionAction
  condition       PermissionCondition   @default(any)
  effect          PermissionEffect
  createdBy       String                @map("created_by") @db.Uuid
  createdByPerson Person                @relation("UnitPolicyGrantCreatedBy", fields: [createdBy], references: [id])
  createdAt       DateTime              @default(now()) @map("created_at")
  reason          String
  expiresAt       DateTime?             @map("expires_at")

  @@map("unit_policy_grant")
}

model PersonGrant {
  id              String              @id @default(uuid()) @db.Uuid
  personId        String              @map("person_id") @db.Uuid
  person          Person              @relation("PersonGrantSubject", fields: [personId], references: [id])
  orgUnitId       String              @map("org_unit_id") @db.Uuid
  orgUnit         OrgUnit             @relation(fields: [orgUnitId], references: [id])
  resource        String
  resourceRef     ResourceCatalog     @relation(fields: [resource], references: [resource])
  action          PermissionAction
  condition       PermissionCondition @default(any)
  effect          PermissionEffect
  grantedBy       String              @map("granted_by") @db.Uuid
  grantedByPerson Person              @relation("PersonGrantGrantedBy", fields: [grantedBy], references: [id])
  grantedAt       DateTime            @default(now()) @map("granted_at")
  reason          String
  expiresAt       DateTime?           @map("expires_at")

  @@map("person_grant")
}

enum AuditEventType {
  break_glass_mint
  restricted_read
  org_unit_reparented
  org_unit_created
  org_unit_updated
  /// The unit is gone by the time this row is written, so it carries the *parent's* org_unit_id; the deleted unit's id, path and name live in `metadata`.
  org_unit_deleted
  role_assignment_created
  role_assignment_ended
  person_grant_created
  unit_policy_grant_created
  platform_role_granted
  platform_role_revoked
  /// Users admin: super-admin cleared another person's session and set a new
  /// argon2id password hash. Written by PersonRepository.setPassword; never
  /// carries the plaintext or the hash.
  person_password_reset
  /// Users admin: super-admin soft-deleted a person. Written by
  /// PersonRepository.softDelete in the same transaction as the actual
  /// state change (deletedAt, roleAssignment end, membership deactivation,
  /// permissionVersion bump).
  person_soft_deleted
  /// Users admin: super-admin restored a soft-deleted person (deletedAt
  /// cleared, status reset to 'invited'). Written by PersonRepository.restore.
  /// Role assignments and club memberships ended at delete time are not
  /// reinstated — restoring undoes the deletion marker, not history.
  person_restored
}

model AuditEvent {
  id            String            @id @default(uuid()) @db.Uuid
  occurredAt    DateTime          @default(now()) @map("occurred_at")
  actorPersonId String            @map("actor_person_id") @db.Uuid
  actorPerson   Person            @relation(fields: [actorPersonId], references: [id])
  type          AuditEventType
  resource      String?
  action        PermissionAction?
  orgUnitId     String?           @map("org_unit_id") @db.Uuid
  orgUnit       OrgUnit?          @relation(fields: [orgUnitId], references: [id])
  reason        String?
  metadata      Json              @default("{}")

  @@map("audit_event")
}

/** M4 Slice 1: system-design.md §11.1. Club-local, non-authenticating, VPM-owned. `deleteAfter` is server-computed at create — CLAUDE.md §2 decision 4 (180 days) — and enforced by a later slice's nightly job, not aspirational. */
model Guest {
  id                  String                 @id @default(uuid()) @db.Uuid
  orgUnitId           String                 @map("org_unit_id") @db.Uuid
  orgUnit             OrgUnit                @relation(fields: [orgUnitId], references: [id])
  fullName            String                 @map("full_name")
  email               String?
  phone               String?
  whatsapp            String?
  photoUrl            String?                @map("photo_url")
  bio                 String?
  leadSource          String?                @map("lead_source")
  preferredRole       String?                @map("preferred_role")
  pipelineStatus      GuestPipelineStatus @default(new) @map("pipeline_status")
  convertedToPersonId String?                @map("converted_to_person_id") @db.Uuid
  convertedToPerson   Person?                @relation("GuestConvertedToPerson", fields: [convertedToPersonId], references: [id])
  convertedAt         DateTime?              @map("converted_at")
  deleteAfter         DateTime               @map("delete_after")
  createdBy           String                 @map("created_by") @db.Uuid
  createdByPerson     Person                 @relation("GuestCreatedBy", fields: [createdBy], references: [id])
  createdAt           DateTime               @default(now()) @map("created_at")
  visits              GuestVisit[]
  communications      GuestCommunication[]
  meetingGuests       MeetingGuest[]
  /// M4 Slice 3: set by the nightly retention job once PII is redacted — CLAUDE.md §2 decision 4.
  /// Anonymises (fullName/email/phone/whatsapp/photoUrl/bio) rather than deleting the row, so
  /// GuestVisit/GuestCommunication history and lead-source aggregates stay intact — same
  /// "correct with a new fact, don't destroy the old one" reasoning as append-only ledger rows.
  piiRedactedAt       DateTime?              @map("pii_redacted_at")
  speechEvaluations   SpeechEvaluation[]
  meetingRoleAssignments MeetingRoleAssignment[]

  @@map("guest")
}

enum GuestPipelineStatus {
  new
  contacted
  interested
  not_interested
  joined

  @@map("guest_pipeline_status")
}

enum GuestCommunicationChannel {
  call
  message
  email
  in_person
  other

  @@map("guest_communication_channel")
}

/** M4 Slice 2: system-design.md §11.1's `visits` array, modelled as its own append-only table (same reasoning as MeetingLiveRecord/Vote) rather than a Json array on Guest. */
model GuestVisit {
  id             String   @id @default(uuid()) @db.Uuid
  guestId     String   @map("guest_id") @db.Uuid
  guest       Guest @relation(fields: [guestId], references: [id])
  meetingId      String   @map("meeting_id") @db.Uuid
  meeting        Meeting  @relation(fields: [meetingId], references: [id])
  attendedAt     DateTime @map("attended_at")
  loggedBy       String   @map("logged_by") @db.Uuid
  loggedByPerson Person   @relation(fields: [loggedBy], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([guestId, meetingId])
  @@map("guest_visit")
}

/** M4 Slice 2: system-design.md §11.1's `communications` array — a VPM's dated note log, same reasoning as GuestVisit. */
model GuestCommunication {
  id             String                       @id @default(uuid()) @db.Uuid
  guestId     String                       @map("guest_id") @db.Uuid
  guest       Guest                     @relation(fields: [guestId], references: [id])
  channel        GuestCommunicationChannel
  note           String
  loggedBy       String                       @map("logged_by") @db.Uuid
  loggedByPerson Person                       @relation(fields: [loggedBy], references: [id])
  loggedAt       DateTime                     @default(now()) @map("logged_at")

  @@map("guest_communication")
}

/**
 * M9 Slice 2: the legacy meeting-page Guest List — a per-meeting roster.
 * Rows are either (a) linked to a Guest from the pool via `guestId`,
 * or (b) a manual entry with just name/email/phone/notes. The `present`
 * flag reflects who actually showed up; correcting a mistaken entry is a
 * DELETE, not an audit event — this is a live meeting-day tool.
 *
 * GuestVisit stays separate: it is the append-only pipeline record
 * ("this lead attended a meeting") and is only ever created via a
 * Guest-linked guest. A manual guest never becomes a GuestVisit —
 * they are not in the pipeline.
 */
model MeetingGuest {
  id            String    @id @default(uuid()) @db.Uuid
  meetingId     String    @map("meeting_id") @db.Uuid
  meeting       Meeting   @relation(fields: [meetingId], references: [id])
  fullName      String    @map("full_name") @db.VarChar(200)
  email         String?   @db.VarChar(200)
  phone         String?   @db.VarChar(50)
  notes         String?
  guestId    String?   @map("guest_id") @db.Uuid
  guest      Guest? @relation(fields: [guestId], references: [id])
  present       Boolean   @default(true)
  addedBy       String    @map("added_by") @db.Uuid
  addedByPerson Person    @relation(fields: [addedBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([meetingId, guestId])
  @@index([meetingId])
  @@map("meeting_guest")
}

/**
 * M9 Slice 3: the legacy meeting-page Attendance tab — member headcount.
 *
 * Append-only (CLAUDE.md §1, NFR-4): flipping a member from present to
 * absent writes a *new* row rather than mutating the old one, and
 * `REVOKE UPDATE, DELETE` enforces that at the DB rather than by
 * convention. The roster the UI renders is the latest row per person
 * (`DISTINCT ON (person_id) ... ORDER BY recorded_at DESC`), so the tab
 * still behaves like a simple toggle while the history stays intact.
 *
 * Deliberately separate from `MeetingGuest`: that is the *guest* roster
 * (non-members, deletable), this is the *member* headcount that feeds the
 * club's attendance rate.
 */
model MeetingAttendanceRecord {
  id               String   @id @default(uuid()) @db.Uuid
  meetingId        String   @map("meeting_id") @db.Uuid
  meeting          Meeting  @relation(fields: [meetingId], references: [id])
  personId         String   @map("person_id") @db.Uuid
  person           Person   @relation("MeetingAttendancePerson", fields: [personId], references: [id])
  present          Boolean
  recordedBy       String   @map("recorded_by") @db.Uuid
  recordedByPerson Person   @relation("MeetingAttendanceRecordedBy", fields: [recordedBy], references: [id])
  recordedAt       DateTime @default(now()) @map("recorded_at")

  @@index([meetingId, personId, recordedAt])
  @@map("meeting_attendance_record")
}

/**
 * M9 Slice 4: the legacy meeting-page Resources tab — free-form title +
 * description notes attached to one meeting (a recording link, a slide
 * deck, reference notes).
 *
 * Not `library.item`: that is the club's versioned, reviewed, signed-URL
 * document store (M5). This is throwaway per-meeting scratch content with
 * no file behind it, so it is editable and deletable in place.
 */
model MeetingResource {
  id              String   @id @default(uuid()) @db.Uuid
  meetingId       String   @map("meeting_id") @db.Uuid
  meeting         Meeting  @relation(fields: [meetingId], references: [id])
  position        Int
  title           String   @db.VarChar(200)
  description     String?
  createdBy       String   @map("created_by") @db.Uuid
  createdByPerson Person   @relation(fields: [createdBy], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([meetingId, position])
  @@map("meeting_resource")
}

/**
 * M9 Slice 5: the legacy portal's meeting template. The old schema modelled
 * this as an `isTemplate` flag on the event row itself; here it is its own
 * table so a template never carries a meaningless `scheduledAt`/
 * `programYearId`/lifecycle `status`, and can never leak into a meeting
 * list, the public upcoming-meetings page, or a DCP count.
 *
 * Carries the default role assignments, theme, venue, start time, word of
 * the day, and table-topic questions — i.e. everything "create meeting from
 * template" copies. All snapshots in Json, copied onto real rows on apply
 * and never referenced live.
 *
 * Deliberately no agenda line items: a Toastmasters meeting's running order
 * is fixed and derived from the roles and prepared speakers (the API's
 * `agenda-schedule.ts`), so there is nothing per-meeting to template.
 */
model MeetingTemplate {
  id                  String   @id @default(uuid()) @db.Uuid
  clubUnitId          String   @map("club_unit_id") @db.Uuid
  clubUnit            OrgUnit  @relation(fields: [clubUnitId], references: [id])
  name                String   @db.VarChar(100)
  theme               String?  @db.VarChar(200)
  venue               String?  @db.VarChar(200)
  startTime           String?  @map("start_time") @db.VarChar(5)
  joinUrl             String?  @map("join_url") @db.VarChar(500)
  /// `{ roleKey, personId }[]` — a person may have left the club by the time
  /// the template is applied, so apply resolves and skips missing people
  /// rather than failing.
  roles               Json
  wordOfDay           Json?    @map("word_of_day")
  tableTopicQuestions Json?    @map("table_topic_questions")
  isActive            Boolean  @default(true) @map("is_active")
  createdBy           String   @map("created_by") @db.Uuid
  createdByPerson     Person   @relation(fields: [createdBy], references: [id])
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([clubUnitId])
  @@map("meeting_template")
}

enum LedgerDirection {
  in
  out

  @@map("ledger_direction")
}

enum LedgerCounterpartyKind {
  member
  guest
  vendor
  district
  other

  @@map("ledger_counterparty_kind")
}

/**
 * M4 Slice 5: system-design.md §12.1. Append-only at the DB layer (`REVOKE
 * UPDATE, DELETE`, end of this slice's migration) — corrections are new
 * reversing entries via `reversalOfEntryId`, never an edit. Scope cut: the
 * design's `reversedByEntryId` (the forward pointer) is not a stored column
 * here — it's derivable with `WHERE reversalOfEntryId = X`, so storing it
 * would just be a denormalisation with no new information.
 */
model LedgerEntry {
  id                String                  @id @default(uuid()) @db.Uuid
  orgUnitId         String                  @map("org_unit_id") @db.Uuid
  orgUnit           OrgUnit                 @relation(fields: [orgUnitId], references: [id])
  programYearId     String                  @map("program_year_id")
  programYear       ProgramYear             @relation(fields: [programYearId], references: [id])
  direction         LedgerDirection
  category          String
  amount            Decimal                 @db.Decimal(12, 2)
  currency          String
  occurredOn        DateTime                @map("occurred_on") @db.Date
  counterpartyKind  LedgerCounterpartyKind  @map("counterparty_kind")
  counterpartyRef   String?                 @map("counterparty_ref") @db.Uuid
  counterpartyLabel String                  @map("counterparty_label")
  description       String
  receiptUrl        String?                 @map("receipt_url")
  recordedBy        String                  @map("recorded_by") @db.Uuid
  recordedByPerson  Person                  @relation(fields: [recordedBy], references: [id])
  recordedAt        DateTime                @default(now()) @map("recorded_at")
  reversalOfEntryId String?                 @map("reversal_of_entry_id") @db.Uuid
  reversalOfEntry   LedgerEntry?            @relation("LedgerReversal", fields: [reversalOfEntryId], references: [id])
  reversals         LedgerEntry[]           @relation("LedgerReversal")
  inventoryAcquisitions InventoryItem[]

  @@unique([reversalOfEntryId])
  @@map("ledger_entry")
}

enum DuesRecordStatus {
  due
  partial
  paid
  waived
  lapsed

  @@map("dues_record_status")
}

/**
 * M4 Slice 6: system-design.md §12.1. One row per (membership, period) — a
 * payment dated mid-period is otherwise ambiguous between periods. `status`
 * is a stored column but only ever written by `DuesRecordService`'s explicit
 * `deriveStatus()` handler after a payment is recorded — never an implicit
 * DB trigger/computed column (CLAUDE.md §6's "not by implicit database
 * middleware" rule). Scope cut: `lapsed` is not yet derived — it needs a
 * Mountain-Time deadline-comparison job this slice doesn't build; only
 * due/partial/paid/waived are reachable for now.
 */
model DuesRecord {
  id                 String           @id @default(uuid()) @db.Uuid
  orgUnitId          String           @map("org_unit_id") @db.Uuid
  orgUnit            OrgUnit          @relation(fields: [orgUnitId], references: [id])
  clubMembershipId   String           @map("club_membership_id") @db.Uuid
  clubMembership     ClubMembership   @relation(fields: [clubMembershipId], references: [id])
  personId           String           @map("person_id") @db.Uuid
  person             Person           @relation(fields: [personId], references: [id])
  duesPeriod         String           @map("dues_period")
  programYearId      String           @map("program_year_id")
  programYear        ProgramYear      @relation(fields: [programYearId], references: [id])
  tiAmountDue        Decimal          @map("ti_amount_due") @db.Decimal(10, 2)
  tiAmountPaid       Decimal          @default(0) @map("ti_amount_paid") @db.Decimal(10, 2)
  tiCurrency         String           @map("ti_currency")
  tiPaidAt           DateTime?        @map("ti_paid_at")
  tiSubmittedToWhqAt DateTime?        @map("ti_submitted_to_whq_at")
  localAmountDue     Decimal          @map("local_amount_due") @db.Decimal(10, 2)
  localAmountPaid    Decimal          @default(0) @map("local_amount_paid") @db.Decimal(10, 2)
  localCurrency      String           @map("local_currency")
  localPaidAt        DateTime?        @map("local_paid_at")
  status             DuesRecordStatus @default(due)
  ledgerEntryIds     String[]         @map("ledger_entry_ids") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")

  installmentPlans   InstallmentPlan[]

  @@unique([clubMembershipId, duesPeriod])
  @@map("dues_record")
}

enum InvoiceIssuedToKind {
  member
  guest
  external

  @@map("invoice_issued_to_kind")
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  void

  @@map("invoice_status")
}

/**
 * M4 Slice 7: system-design.md §12.2/§19.3 I-13 — invoice numbers are
 * gapless per (club, program year), via this sequence table plus a row lock
 * (`SELECT ... FOR UPDATE` in `InvoiceRepository.nextNumber`), never
 * `MAX(number)+1`, which races under concurrency.
 */
model InvoiceSequence {
  orgUnitId     String      @map("org_unit_id") @db.Uuid
  orgUnit       OrgUnit     @relation(fields: [orgUnitId], references: [id])
  programYearId String      @map("program_year_id")
  programYear   ProgramYear @relation(fields: [programYearId], references: [id])
  nextNumber    Int         @default(1) @map("next_number")

  @@id([orgUnitId, programYearId])
  @@map("invoice_sequence")
}

/**
 * M4 Slice 7: system-design.md §12.2. `lines`/`payments` are Json snapshots
 * (same reasoning as `ChecklistTemplate.items`) — a line's `duesRecordId`
 * links back to Slice 6's `DuesRecord` for reconciliation, never embeds it.
 * Never edited after issue — corrections are a credit note (a new,
 * negative-total `Invoice` referencing this one via `creditNoteForInvoiceId`),
 * not a mutation of `lines`/`subtotal`/`total`; the API only ever exposes an
 * endpoint to create one, never to edit an issued invoice's amounts.
 */
model Invoice {
  id                     String              @id @default(uuid()) @db.Uuid
  orgUnitId              String              @map("org_unit_id") @db.Uuid
  orgUnit                OrgUnit             @relation(fields: [orgUnitId], references: [id])
  programYearId          String              @map("program_year_id")
  programYear            ProgramYear         @relation(fields: [programYearId], references: [id])
  invoiceNumber          String              @map("invoice_number")
  issuedToKind           InvoiceIssuedToKind @map("issued_to_kind")
  issuedToRef            String?             @map("issued_to_ref") @db.Uuid
  issuedToName           String              @map("issued_to_name")
  issuedToEmail          String?             @map("issued_to_email")
  issuedOn               DateTime            @default(now()) @map("issued_on") @db.Date
  dueOn                  DateTime            @map("due_on") @db.Date
  lines                  Json
  subtotal               Decimal             @db.Decimal(12, 2)
  total                  Decimal             @db.Decimal(12, 2)
  currency               String
  status                 InvoiceStatus       @default(issued)
  payments               Json                @default("[]")
  pdfUrl                 String?             @map("pdf_url")
  sentAt                 DateTime?           @map("sent_at")
  voidReason              String?            @map("void_reason")
  creditNoteForInvoiceId String?             @map("credit_note_for_invoice_id") @db.Uuid
  creditNoteForInvoice   Invoice?            @relation("InvoiceCreditNote", fields: [creditNoteForInvoiceId], references: [id])
  creditNotes            Invoice[]           @relation("InvoiceCreditNote")
  createdAt              DateTime            @default(now()) @map("created_at")

  @@unique([orgUnitId, programYearId, invoiceNumber])
  @@map("invoice")
}

enum InstallmentPlanStatus {
  active
  completed
  defaulted
  cancelled

  @@map("installment_plan_status")
}

/**
 * M4 Slice 8: system-design.md §12.3 / CLAUDE.md §2 decision 8 (Treasurer
 * approves alone — `approvedBy` is satisfied by the caller holding
 * `finance.installment_plan:create` at this club, no separate approval
 * step). `schedule` is a Json array (`{seq, dueOn, amount, paidAt,
 * ledgerEntryId}[]`); I-14 (`SUM(schedule.amount) = totalAmount`) is
 * asserted in `InstallmentPlanService`, not a DB constraint — Postgres has
 * no cheap way to sum a jsonb array in a CHECK constraint.
 *
 * Design-text note on `totalAmount`: system-design.md says the plan "covers
 * local dues only" but also that an outstanding TI portion is "front-loaded
 * in the plan's schedule" — read literally these are in tension (if TI is
 * *in* the schedule, `totalAmount` can't equal local-only and still satisfy
 * I-14). This implementation resolves it by including any outstanding TI
 * amount as an immediately-due schedule entry (seq 1, dueOn = today) ahead
 * of the local instalments, and `totalAmount` covers everything actually in
 * the schedule (TI + local) — so I-14 holds exactly, and TI still reaches
 * WHQ first as the design intends.
 */
model InstallmentPlan {
  id             String                @id @default(uuid()) @db.Uuid
  orgUnitId      String                @map("org_unit_id") @db.Uuid
  orgUnit        OrgUnit               @relation(fields: [orgUnitId], references: [id])
  duesRecordId   String                @map("dues_record_id") @db.Uuid
  duesRecord     DuesRecord            @relation(fields: [duesRecordId], references: [id])
  personId       String                @map("person_id") @db.Uuid
  person         Person                @relation("InstallmentPlanPerson", fields: [personId], references: [id])
  totalAmount    Decimal               @map("total_amount") @db.Decimal(10, 2)
  currency       String
  schedule       Json
  status         InstallmentPlanStatus @default(active)
  approvedBy     String                @map("approved_by") @db.Uuid
  approvedByPerson Person              @relation("InstallmentPlanApprovedBy", fields: [approvedBy], references: [id])
  createdAt      DateTime              @default(now()) @map("created_at")
  notes          String?

  @@map("installment_plan")
}

