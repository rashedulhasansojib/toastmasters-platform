  closingBalance    Decimal                @map("closing_balance") @db.Decimal(12, 2)
  currency          String
  income            Json
  expenses          Json
  duesSummary       Json                   @map("dues_summary")
  memberCounts      Json                   @map("member_counts")
  narrative         String?
  status            FinancialReportStatus  @default(draft)
  generatedBy       String                 @map("generated_by") @db.Uuid
  generatedByPerson Person                 @relation("FinancialReportGeneratedBy", fields: [generatedBy], references: [id])
  generatedAt       DateTime               @default(now()) @map("generated_at")
  approvedBy        String?                @map("approved_by") @db.Uuid
  approvedByPerson  Person?                @relation("FinancialReportApprovedBy", fields: [approvedBy], references: [id])
  approvedAt        DateTime?              @map("approved_at")
