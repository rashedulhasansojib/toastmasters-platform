{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "src/generated/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:int": {
      "dependsOn": ["^build"],
      "cache": false,
      // Turbo runs tasks in a filtered environment, so vars exported by the
      // caller never reach vitest unless declared here. The integration suite
      // boots the real Nest app, whose S3StorageAdapter throws at DI time when
      // these are unset — without them ~20 specs die in beforeAll. Supplied by a
      // developer's .env locally, and by quality.yml in CI.
      "passThroughEnv": ["S3_*"]
    },
    "generate": {
      "cache": false
    }
  }
}
